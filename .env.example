# Copy to .env for local development. Real secrets live in Secret Manager.

# GCP
GOOGLE_CLOUD_PROJECT=atlasmind-stage
GOOGLE_CLOUD_REGION=europe-west1
ATLASMIND_ENV=stage

# Vertex AI
VERTEX_LOCATION=europe-west1
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash

# BigQuery
BQ_DATASET_WAREHOUSE=atlasmind_warehouse
BQ_DATASET_CLAIMS=atlasmind_claims
BQ_DATASET_RUNS=atlasmind_runs
BQ_DATASET_SCORES=atlasmind_scores

# Pub/Sub
TOPIC_RUNS_REQUESTED=runs.requested
TOPIC_AGENTS_COMPLETED=agents.completed
TOPIC_RUNS_COMPLETED=runs.completed
TOPIC_ALERTS_TRIGGERED=alerts.triggered

# Storage
GCS_BUCKET_RAW=atlasmind-raw
GCS_BUCKET_RUNS=atlasmind-runs
GCS_BUCKET_TEMPLATES=atlasmind-templates

# Firebase
FIRESTORE_DATABASE=(default)

# Workspace
WORKSPACE_DOMAIN=atlasmind.ai
DRIVE_BRIEFINGS_FOLDER_ID=
